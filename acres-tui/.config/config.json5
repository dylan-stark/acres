{
  // A key is looked up in the focused pane's context first (List, Art, Record, Search, or
  // Overlay while an overlay is open), then in Global. The search bar only
  // falls back to Global for ctrl keys, so every other key types itself there.
  "keybindings": {
    "Global": {
      "<?>": "ToggleHelp", // Toggle the help overlay
      "</>": "FocusSearch", // Focus the search bar
      "<1>": "FocusSearch", // Focus pane 1, the search bar
      "<2>": "FocusResults", // Focus pane 2, the results
      "<3>": "FocusArt", // Focus pane 3, the art
      "<4>": "FocusRecord", // Focus pane 4, the record
      "tab": "FocusNext", // Focus the next pane
      "shift-tab": "FocusPrevious", // Focus the previous pane
      "<n>": "NextArtwork", // Select the next artwork, from any pane
      "<p>": "PreviousArtwork", // Select the previous artwork, from any pane
      "<space>": "ShowFullImage", // Fetch and show the full image
      "<o>": "OpenInBrowser", // Open the artwork's page on artic.edu
      "<y>": "CopyLink", // Copy the link to the artwork's page
      "<f>": "OpenFilters", // Filter the search: image, public domain, on view, department, type, years
      "<s>": "CycleSort", // Cycle the sort: relevance, oldest, newest, title
      "<A>": "MoreByArtist", // List more by the selected artwork's artist
      "<D>": "MoreFromDepartment", // List more from the selected artwork's department
      "<R>": "Surprise", // Show a random artwork that matches the filters
      "backspace": "Back", // Back to the previous list, with its cursor
      "<m>": "ToggleSaved", // Save or unsave the selected artwork
      "<'>": "SwitchSaved", // Switch between the results and the saved list
      "<e>": "EditNote", // Edit the note on a saved artwork
      "<z>": "ToggleZen", // Zen: art only, full screen
      "<b>": "CycleArtMode", // Cycle half blocks, quadrant blocks and ASCII
      "<r>": "PickRamp", // Pick a ramp (ASCII mode)
      "<t>": "ToggleHud", // Toggle the timing HUD
      "<!>": "ShowLastFailure", // Show the last failure again, with its hint
      "esc": "Cancel", // Close an overlay or leave zen
      "<q>": "AskQuit", // Quit, after asking (q again or enter to confirm)
      "<Ctrl-c>": "Quit", // Quit without asking
      "<Ctrl-z>": "Suspend", // Suspend
    },
    "List": {
      "<j>": "MoveDown",
      "down": "MoveDown",
      "<k>": "MoveUp",
      "up": "MoveUp",
      "<g>": "Top",
      "<G>": "Bottom",
      "<Ctrl-d>": "HalfPageDown",
      "<Ctrl-u>": "HalfPageUp",
      "enter": "ShowFullImage", // Fetch and show the full image
    },
    "Art": {
      // Zen uses these too. `h j k l` and the arrows pan by a cell, with shift by a tenth of
      // the view.
      "enter": "ShowFullImage", // Fetch and show the full image
      "<+>": "ZoomIn", // Zoom in, by 1.25x and then by whole pixels
      "<=>": "ZoomIn",
      "<->": "ZoomOut", // Zoom out, down to fit
      "<h>": "PanLeft",
      "left": "PanLeft",
      "<j>": "PanDown",
      "down": "PanDown",
      "<k>": "PanUp",
      "up": "PanUp",
      "<l>": "PanRight",
      "right": "PanRight",
      "<H>": "PanLeftFar",
      "shift-left": "PanLeftFar",
      "<J>": "PanDownFar",
      "shift-down": "PanDownFar",
      "<K>": "PanUpFar",
      "shift-up": "PanUpFar",
      "<L>": "PanRightFar",
      "shift-right": "PanRightFar",
      "<0>": "FitArt", // Fit the whole image
      "<F>": "FillArt", // Fill the frame, cropping the overflow
      "<S>": "PickFrame", // Pick the frame size: pane, screen, stamp, postcard or custom
      "<v>": "SaveView", // Save this view under a name, saving the artwork too
      "<V>": "ListViews", // List the artwork's saved views: show, rename (e) or delete (x)
      "<X>": "ExportArt", // Export the art as .ans (and .txt in ASCII) to exports/ in the data directory
    },
    "Record": {
      "<d>": "ToggleFullRecord", // Expand the wall label to the full record, or collapse it
      "enter": "OpenRecord", // Open the full record in a large overlay
      "<j>": "MoveDown", // Scroll the record
      "down": "MoveDown",
      "<k>": "MoveUp",
      "up": "MoveUp",
      "<g>": "Top",
      "<G>": "Bottom",
      "<Ctrl-d>": "HalfPageDown",
      "<Ctrl-u>": "HalfPageUp",
    },
    "Search": {
      "enter": "RunSearch", // Run the search and focus the results
      "up": "EarlierQuery", // Recall an earlier query
      "down": "LaterQuery",
      "<Ctrl-u>": "ClearSearch", // Clear the query
      "esc": "Cancel", // Leave the search bar, keeping the query
    },
    "Overlay": {
      "<j>": "MoveDown",
      "down": "MoveDown",
      "<k>": "MoveUp",
      "up": "MoveUp",
      "<g>": "Top",
      "<G>": "Bottom",
      "enter": "Select", // Choose a ramp or a frame size, apply the filters, save a note, or quit from the quit prompt
      "<h>": "PreviousOption", // Change the highlighted filter
      "left": "PreviousOption",
      "<l>": "NextOption",
      "right": "NextOption",
      "<Ctrl-u>": "ClearSearch", // Reset the filters, or clear the note or view name
      "<x>": "DeleteView", // Delete the highlighted saved view
    },
  }
}
